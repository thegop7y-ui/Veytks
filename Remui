    ---------------------------------------------------------------- Key tab
    function Window:AddKeyTab(name)
        local Tab = MakeTab(name, nil)
        local keyBoxHolder = New("Frame", {
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
        }, Tab._directHolder or content)
        -- find the tab's direct holder through its page
        for _, d in ipairs(content:GetChildren()) do
            if d.Name == name .. "_Page" then
                local dh = d:FindFirstChildWhichIsA("Frame")
                if dh then keyBoxHolder.Parent = dh end
            end
        end

        local keyBox = New("TextBox", {
            Size = UDim2.new(1, -70, 0, 22),
            BackgroundColor3 = Library.Scheme.Container,
            TextColor3 = Library.Scheme.Text,
            Font = FONT, TextSize = 12,
            PlaceholderText = "Enter key...",
            PlaceholderColor3 = Library.Scheme.Dim,
            Text = "",
            ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, keyBoxHolder)
        Corner(keyBox)
        Stroke(keyBox)
        New("UIPadding", { PaddingLeft = UDim.new(0, 6) }, keyBox)

        local submit = New("TextButton", {
            Size = UDim2.new(0, 62, 0, 22),
            Position = UDim2.new(1, -62, 0, 0),
            BackgroundColor3 = Library.Scheme.Element,
            TextColor3 = Library.Scheme.Text,
            Font = FONT, TextSize = 11,
            Text = "Submit",
            AutoButtonColor = false,
        }, keyBoxHolder)
        Corner(submit)
        Stroke(submit)
        submit.MouseEnter:Connect(function() Tween(submit, .1, { BackgroundColor3 = Library.Scheme.Container }) end)
        submit.MouseLeave:Connect(function() Tween(submit, .1, { BackgroundColor3 = Library.Scheme.Element }) end)

        local cb = nil
        local function doSubmit()
            if cb then
                task.spawn(cb, keyBox.Text)
            end
        end
        submit.MouseButton1Click:Connect(doSubmit)
        keyBox.FocusLost:Connect(function(enter)
            if enter then doSubmit() end
        end)

        function Tab:AddKeyBox(callback)
            cb = callback
            return keyBox
        end
        return Tab
    end

    hideBtn.MouseButton1Click:Connect(function()
        win.Visible = not win.Visible
        if Library._kbVisibilityControl then
            keybindFrame.Visible = win.Visible
        end
    end)

    -- menu keybind handling (RightShift default + Library.ToggleKeybind override)
    Connect(UserInputService.InputBegan, function(input, gpe)
        if Library.Unloaded or gpe then return end
        local custom = Library.ToggleKeybind and Library.ToggleKeybind.Value
        if MatchesInput("RightShift", input) or (custom and MatchesInput(custom, input)) then
            win.Visible = not win.Visible
            if Library._kbVisibilityControl then
                keybindFrame.Visible = win.Visible
            end
        end
    end)

    function Window:SetCornerRadius(r)
        Library.CornerRadius = r
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("UICorner") then d.CornerRadius = UDim.new(0, r) end
        end
    end

    function Window:SetAlwaysOnTop(v)
        Window.AlwaysOnTop = v
        pcall(function() gui.DisplayOrder = v and 9999 or 999 end)
        pcall(function() gui.OnTopOfCoreBlur = v end)
    end

    ---------------------------------------------------------------- Unload
    function Library:OnUnload(fn)
        self._onUnload = fn
    end

    function Library:Unload()
        Library.Unloaded = true
        pcall(function() UserInputService.MouseIconEnabled = true end)
        for _, c in ipairs(Library.Signals) do pcall(function() c:Disconnect() end) end
        if self._onUnload then task.spawn(self._onUnload) end
        gui:Destroy()
    end

    if cfg.AutoShow == false then
        win.Visible = false
    end
    if cfg.Center then
        win.Position = UDim2.new(0.5, -win.AbsoluteSize.X / 2, 0.5, -win.AbsoluteSize.Y / 2)
    end

    return Window
end

