        ---------------------------------------------------------------- Slider
        function Container:AddSlider(idx, info)
            idx, info = Resolve(idx, info)
            local min, max = info.Min or 0, info.Max or 100
            local rounding = info.Rounding or 0
            local slider = MakeElement(idx, math.clamp(info.Default or min, min, max))
            slider.Callback = info.Callback
            slider.Text = info.Text

            local holder = New("Frame", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundTransparency = 1,
                Visible = info.Visible ~= false,
            }, elementHolder)

            local valueLbl = AddText(holder, "", 11, Library.Scheme.Dim, false,
                Enum.TextXAlignment.Right)
            valueLbl.Position = UDim2.new(1, -70, 0, 0)
            valueLbl.Size = UDim2.new(0, 70, 0, 14)

            if not info.Compact then
                local t = AddText(holder, info.Text or idx, 12, Library.Scheme.Text)
                t.Size = UDim2.new(1, -80, 0, 14)
                if info.Disabled then t.TextTransparency = 0.5 end
            end

            local function Format()
                local v = string.format("%." .. rounding .. "f", slider.Value)
                if info.FormatDisplayValue then
                    local custom = info.FormatDisplayValue(slider, slider.Value)
                    if custom ~= nil then return tostring(custom) end
                end
                if info.HideMax or info.Compact then
                    return v .. (info.Suffix or "")
                end
                return v .. " / " .. max .. (info.Suffix or "")
            end

            local bar = New("Frame", {
                Size = UDim2.new(1, 0, 0, 6),
                Position = UDim2.new(0, 0, 0, 20),
                BackgroundColor3 = Library.Scheme.Container,
                BorderSizePixel = 0,
            }, holder)
            Corner(bar, 3)
            Stroke(bar)

            local fill = New("Frame", {
                Size = UDim2.new((slider.Value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = Library.Scheme.Accent,
                BorderSizePixel = 0,
            }, bar)
            Corner(fill, 3)
            RegisterThemeObject(fill, "BackgroundColor3", "Accent")
            slider._fill = fill

            local function refresh()
                valueLbl.Text = Format()
                fill.Size = UDim2.new((slider.Value - min) / (max - min), 0, 1, 0)
            end
            refresh()

            function slider:SetValue(v, nocb)
                slider.Value = math.clamp(tonumber(v) or min, min, max)
                refresh()
                if not nocb then
                    if slider.Callback then task.spawn(slider.Callback, slider.Value) end
                    slider:_Fire()
                end
            end

            local dragging = false
            local function setFromX(x)
                local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                slider:SetValue(min + rel * (max - min))
            end
            bar.InputBegan:Connect(function(input)
                if info.Disabled then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    setFromX(input.Position.X)
                end
            end)
            Connect(UserInputService.InputChanged, function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    setFromX(input.Position.X)
                end
            end)
            Connect(UserInputService.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)

            Options[idx] = slider
            HookTooltip(bar, info)
            return slider
        end

        ---------------------------------------------------------------- Input
        function Container:AddInput(idx, info)
            idx, info = Resolve(idx, info)
            local input = MakeElement(idx, info.Default or "")
            input.Callback = info.Callback

            local holder = New("Frame", {
                Size = UDim2.new(1, 0, 0, 42),
                BackgroundTransparency = 1,
                Visible = info.Visible ~= false,
            }, elementHolder)

            if info.Text then
                local l = AddText(holder, info.Text, 12, Library.Scheme.Text)
                l.Size = UDim2.new(1, 0, 0, 14)
            end

            local box = New("TextBox", {
                Size = UDim2.new(1, 0, 0, 20),
                Position = UDim2.new(0, 0, 0, 18),
                BackgroundColor3 = Library.Scheme.Container,
                TextColor3 = Library.Scheme.Text,
                Font = FONT,
                TextSize = 12,
                Text = input.Value,
                PlaceholderText = info.Placeholder or "",
                PlaceholderColor3 = Library.Scheme.Dim,
                ClearTextOnFocus = info.ClearTextOnFocus ~= false,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, holder)
            Corner(box)
            Stroke(box)
            New("UIPadding", { PaddingLeft = UDim.new(0, 6) }, box)

            local function commit()
                local t = box.Text
                if info.Numeric then
                    t = t:gsub("[^%d%.%-%+eE]", "")
                    box.Text = t
                end
                if info.MaxLength and #t > info.MaxLength then
                    t = t:sub(1, info.MaxLength)
                    box.Text = t
                end
                if input.Value == t then return end
                input.Value = t
                if input.Callback then task.spawn(input.Callback, t) end
                input:_Fire()
            end

            box.FocusLost:Connect(function(enter)
                if info.Finished and not enter then return end
                commit()
            end)
            if not info.Finished then
                box:GetPropertyChangedSignal("Text"):Connect(commit)
            end

            function input:SetValue(t)
                box.Text = t
                commit()
            end

            Options[idx] = input
            HookTooltip(box, info)
            return input
        end

        ---------------------------------------------------------------- Dropdown
        function Container:AddDropdown(idx, info)
            idx, info = Resolve(idx, info)
            local dd = MakeElement(idx, nil)
            dd.Multi = info.Multi == true
            dd.Searchable = info.Searchable == true
            dd.MaxVisible = info.MaxVisibleDropdownItems or 8
            dd.DisabledValues = info.DisabledValues or {}
            dd.Callback = info.Callback
            dd.Text = info.Text
            dd.SpecialType = info.SpecialType
            dd.FormatDisplayValue = info.FormatDisplayValue

            -- detect dictionary values: { key = "Label" }
            local rawValues = info.Values or {}
            local isDict = false
            for k in pairs(rawValues) do
                if type(k) == "string" then isDict = true end
                break
            end
            dd.IsDictionary = isDict
            dd.RawValues = rawValues

            local function OrderedKeys()
                local keys = {}
                if isDict then
                    for k in pairs(rawValues) do table.insert(keys, k) end
                else
                    for i, v in ipairs(rawValues) do table.insert(keys, v) end
                end
                return keys
            end
            dd.Values = OrderedKeys()

            local function LabelOf(v)
                if isDict then return rawValues[v] or tostring(v) end
                return tostring(v)
            end
            dd.LabelOf = LabelOf

            if dd.Multi then
                dd.Value = {}
                if type(info.Default) == "table" then dd.Value = info.Default end
            else
                if type(info.Default) == "number" then
                    dd.Value = dd.Values[info.Default]
                elseif info.Default ~= nil then
                    dd.Value = info.Default
                end
            end

            local holder = New("Frame", {
                Size = UDim2.new(1, 0, 0, 42),
                BackgroundTransparency = 1,
                Visible = info.Visible ~= false,
            }, elementHolder)

            if info.Text then
                local l = AddText(holder, info.Text, 12, Library.Scheme.Text)
                l.Size = UDim2.new(1, 0, 0, 14)
                if info.Disabled then l.TextTransparency = 0.5 end
            end

            local btn = New("TextButton", {
                Size = UDim2.new(1, 0, 0, 20),
                Position = UDim2.new(0, 0, 0, 18),
                BackgroundColor3 = Library.Scheme.Container,
                TextColor3 = Library.Scheme.Dim,
                Font = FONT,
                TextSize = 12,
                Text = "",
                AutoButtonColor = false,
            }, holder)
            Corner(btn)
            Stroke(btn)

            local arrow = AddText(btn, "▾", 11, Library.Scheme.Dim, false,
                Enum.TextXAlignment.Right)
            arrow.Position = UDim2.new(1, -18, 0, 0)
            arrow.Size = UDim2.new(0, 16, 0, 20)

            local function Display(v)
                local base = dd.LabelOf(v)
                if dd.FormatDisplayValue then
                    local c = dd.FormatDisplayValue(v)
                    if c ~= nil then return tostring(c) end
                end
                return base
            end

            local function refreshBtn()
                if dd.Multi then
                    local parts = {}
                    for k, on in pairs(dd.Value) do
                        if on then table.insert(parts, Display(k)) end
                    end
                    table.sort(parts)
                    btn.Text = #parts > 0 and table.concat(parts, ", ") or "..."
                else
                    btn.Text = dd.Value ~= nil and Display(dd.Value) or "..."
                end
            end
            refreshBtn()

            local function Fire()
                if dd.Callback then task.spawn(dd.Callback, dd.Value) end
                dd:_Fire()
            end

            function dd:SetValue(v, nocb)
                if dd.Multi then
                    if type(v) == "table" then
                        if nocb then
                            dd.Value = {}
                        end
                        for k, on in pairs(v) do
                            if type(k) == "number" and not isDict then
                                dd.Value[dd.Values[k]] = on
                            else
                                dd.Value[k] = on
                            end
                        end
                    end
                else
                    if type(v) == "number" then v = dd.Values[v] end
                    dd.Value = v
                end
                refreshBtn()
                if not nocb then Fire() end
            end

            local listOpen = false

            local function OpenList()
                Library:ClosePopups()
                ClickCatcher(60)

                if dd.SpecialType == "Player" then
                    dd.Values = {}
                    for _, p in ipairs(Players:GetPlayers()) do
                        if not (info.ExcludeLocalPlayer and p == LocalPlayer) then
                            table.insert(dd.Values, p.Name)
                        end
                    end
                elseif dd.SpecialType == "Team" then
                    dd.Values = {}
                    for _, t in ipairs(Teams:GetTeams()) do
                        table.insert(dd.Values, t.Name)
                    end
                end

                local popup = New("Frame", {
                    Size = UDim2.new(0, btn.AbsoluteSize.X, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Position = UDim2.new(0, btn.AbsolutePosition.X,
                                         0, btn.AbsolutePosition.Y + 22),
                    BackgroundColor3 = Library.Scheme.Background,
                    BorderSizePixel = 0,
                    ZIndex = 61,
                }, popupLayer)
                Corner(popup)
                Stroke(popup)
                New("UIPadding", {
                    PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
                    PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
                }, popup)
                TrackPopup(popup)

                local searchFilter = nil
                local searchBox
                local listTop = 0

                if dd.Searchable then
                    searchBox = New("TextBox", {
                        Size = UDim2.new(1, 0, 0, 18),
                        BackgroundColor3 = Library.Scheme.Container,
                        TextColor3 = Library.Scheme.Text,
                        Font = FONT, TextSize = 11,
                        PlaceholderText = "Search...",
                        PlaceholderColor3 = Library.Scheme.Dim,
                        Text = "",
                        ZIndex = 62,
                    }, popup)
                    Corner(searchBox, 2)
                    Stroke(searchBox)
                    listTop = 24
                end

                local list = New("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, math.min(#dd.Values, dd.MaxVisible) * 22 + 4),
                    Position = UDim2.new(0, 0, 0, listTop),
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = Library.Scheme.Accent,
                    BackgroundTransparency = 1,
                    ZIndex = 62,
                }, popup)
                New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)

                local function isDisabled(v)
                    for _, dVal in ipairs(dd.DisabledValues) do
                        if dVal == v or dVal == dd.LabelOf(v) then return true end
                    end
                    return false
                end

                local function BuildItems()
                    for _, ch in ipairs(list:GetChildren()) do
                        if ch:IsA("TextButton") then ch:Destroy() end
                    end
                    local count = 0
                    for i, v in ipairs(dd.Values) do
                        if not searchFilter or searchFilter == ""
                        or string.find(string.lower(dd.LabelOf(v)),
                            string.lower(searchFilter), 1, true) then
                            count += 1
                            local item = New("TextButton", {
                                Size = UDim2.new(1, 0, 0, 20),
                                BackgroundColor3 = Library.Scheme.Container,
                                TextColor3 = isDisabled(v) and Library.Scheme.Dim
                                    or (dd.Multi and dd.Value[v] and Library.Scheme.Accent
                                        or Library.Scheme.Text),
                                Font = FONT, TextSize = 11,
                                Text = (dd.Multi and (dd.Value[v] and "☑ " or "☐ ") or "") .. Display(v),
                                AutoButtonColor = false,
                                LayoutOrder = i,
                                ZIndex = 62,
                                TextXAlignment = Enum.TextXAlignment.Left,
                            }, list)
                            New("UIPadding", { PaddingLeft = UDim.new(0, 6) }, item)
                            Corner(item, 2)

                            item.MouseEnter:Connect(function()
                                Tween(item, .08, { BackgroundColor3 = Library.Scheme.Element })
                            end)
                            item.MouseLeave:Connect(function()
                                Tween(item, .08, { BackgroundColor3 = Library.Scheme.Container })
                            end)
                            item.MouseButton1Click:Connect(function()
                                if isDisabled(v) then return end
                                if dd.Multi then
                                    dd.Value[v] = not dd.Value[v]
                                else
                                    dd.Value = v
                                end
                                refreshBtn()
                                Fire()
                                if dd.Multi then
                                    BuildItems()
                                else
                                    Library:ClosePopups()
                                    listOpen = false
                                end
                            end)
                        end
                    end
                    list.Size = UDim2.new(1, 0, 0, math.min(math.max(count, 1), dd.MaxVisible) * 22 + 4)
                end
                BuildItems()

                if searchBox then
                    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                        searchFilter = searchBox.Text
                        BuildItems()
                    end)
                end

                listOpen = true
            end

            btn.MouseButton1Click:Connect(function()
                if info.Disabled then return end
                if listOpen then
                    Library:ClosePopups()
                    listOpen = false
                else
                    OpenList()
                end
            end)

            Options[idx] = dd
            HookTooltip(btn, info)
            return dd
        end
    end

