            Size = UDim2.new(0, 3, 1, 0),
            BackgroundColor3 = Library.Scheme.Accent,
            BorderSizePixel = 0,
        }, n)
        Corner(bar, 2)
        RegisterThemeObject(bar, "BackgroundColor3", "Accent")

        local body = New("Frame", {
            Size = UDim2.new(1, -10, 0, 0),
            Position = UDim2.new(0, 10, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
        }, n)
        New("UIListLayout", { Padding = UDim.new(0, 2) }, body)

        AddText(body, info.Title or "Notification", 12, Library.Scheme.Text, true)
        if info.Description then
            local d = AddText(body, info.Description, 11, Library.Scheme.Dim, false,
                Enum.TextXAlignment.Left, true)
            d.Size = UDim2.new(1, 0, 0, 0)
            d.AutomaticSize = Enum.AutomaticSize.Y
        end

        task.delay(info.Time or 5, function()
            if not n or not n.Parent then return end
            Tween(n, 0.3, { BackgroundTransparency = 1 })
            for _, ch in ipairs(n:GetDescendants()) do
                if ch:IsA("TextLabel") or ch:IsA("TextButton") then
                    Tween(ch, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
                elseif ch:IsA("Frame") then
                    Tween(ch, 0.3, { BackgroundTransparency = 1 })
                elseif ch:IsA("UIStroke") then
                    Tween(ch, 0.3, { Transparency = 1 })
                end
            end
            task.wait(0.35)
            n:Destroy()
        end)
        return n
    end

