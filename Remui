function Library:AddDraggableLabel(text)
    local lbl = AddText(self.Gui, text, 14, self.Scheme.Text, true)
    lbl.Position = UDim2.new(0, 200, 0, 200)
    lbl.Size = UDim2.new(0, 0, 0, 20)
    lbl.AutomaticSize = Enum.AutomaticSize.X
    lbl.Active = true
    local dragging, ds, sp
    lbl.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true ds = i.Position sp = lbl.Position
        end
    end)
    lbl.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    self.Connect(UserInputService.InputChanged, function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - ds
            lbl.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end)
    return lbl
end

