--[[====================================================================
    SaveManager  (dans CE fichier)
======================================================================]]
local SaveManager = {
    Folder = "ui_lib",
    SubFolder = nil,
    Ignore = {},
    Library = Library,
}

function SaveManager:SetLibrary(lib) self.Library = lib end
function SaveManager:SetFolder(f) self.Folder = f end
function SaveManager:SetSubFolder(f) self.SubFolder = f end
function SaveManager:SetIgnoreIndexes(t) for _, i in ipairs(t) do self.Ignore[i] = true end end
function SaveManager:IgnoreThemeSettings()
    for k in pairs(ThemeManager.IgnoredIndexes) do self.Ignore[k] = true end
end

function SaveManager:BuildPath()
    local p = self.Folder .. "/settings"
    if self.SubFolder then p = p .. "/" .. self.SubFolder end
    return p
end

function SaveManager:GetConfigs()
    local out = {}
    if not hasfile then return out end
    local ok, files = pcall(listfiles, self:BuildPath())
    if ok and files then
        for _, f in ipairs(files) do
            local name = f:match("([^/\\]+)%.json$")
            if name and name ~= "autoload" then table.insert(out, name) end
        end
    end
    table.sort(out)
    return out
end

function SaveManager:Save(name)
    if not hasfile then
        warn("[SaveManager] filesystem unavailable")
        return false
    end
    name = tostring(name or "config")
    local data = { Options = {}, Toggles = {} }
    for idx, opt in pairs(Library.Options) do
        if not self.Ignore[idx] and opt.Value ~= nil then
            local v = opt.Value
            if typeof(v) == "Color3" then
                data.Options[idx] = { __type = "Color3", R = v.R, G = v.G, B = v.B }
            elseif typeof(v) == "table" or typeof(v) == "string"
                or typeof(v) == "number" or typeof(v) == "boolean" then
                data.Options[idx] = v
            end
        end
    end
    for idx, t in pairs(Library.Toggles) do
        if not self.Ignore[idx] then
            data.Toggles[idx] = t.Value
        end
    end
    pcall(makefolder, self.Folder)
    pcall(makefolder, self.Folder .. "/settings")
    if self.SubFolder then pcall(makefolder, self.Folder .. "/settings/" .. self.SubFolder) end
    local ok, err = pcall(writefile, self:BuildPath() .. "/" .. name .. ".json",
        HttpService:JSONEncode(data))
    if ok then
        Library:Notify({ Title = "SaveManager", Description = 'Config "' .. name .. '" saved.', Time = 3 })
    else
        warn("[SaveManager] save failed:", err)
    end
    return ok
end

function SaveManager:Load(name)
    if not hasfile then return false end
    name = tostring(name or "config")
    local ok, content = pcall(readfile, self:BuildPath() .. "/" .. name .. ".json")
    if not ok or not content then
        Library:Notify({ Title = "SaveManager", Description = 'Config "' .. name .. '" not found.', Time = 3 })
        return false
    end
    local data = HttpService:JSONDecode(content)
    for idx, v in pairs(data.Toggles or {}) do
        if Library.Toggles[idx] then Library.Toggles[idx]:SetValue(v) end
    end
    for idx, v in pairs(data.Options or {}) do
        local opt = Library.Options[idx]
        if opt then
            if type(v) == "table" and v.__type == "Color3" then
                if opt.SetValueRGB then
                    opt:SetValueRGB(Color3.new(v.R, v.G, v.B))
                end
            elseif opt.SetValue then
                opt:SetValue(v)
            end
        end
    end
    Library:Notify({ Title = "SaveManager", Description = 'Config "' .. name .. '" loaded.', Time = 3 })
    return true
end

function SaveManager:Delete(name)
    if not hasfile then return end
    pcall(delfile, self:BuildPath() .. "/" .. tostring(name) .. ".json")
end

function SaveManager:LoadAutoloadConfig()
    if not hasfile then return end
    local ok, name = pcall(readfile, self:BuildPath() .. "/autoload.txt")
    if ok and name and #name > 0 then
        self:Load(name)
    end
end

function SaveManager:BuildConfigSection(Tab)
    local Groupbox = Tab:AddGroupbox({ Side = "Right", Name = "Configuration" })

    Groupbox:AddInput("ConfigNameInput", {
        Text = "Config name",
        Placeholder = "my config",
        Finished = true,
    })

    local configList
    local function refreshList()
        if configList then
            local configs = SaveManager:GetConfigs()
            configList:SetValue(nil, true)
            configList.Values = configs
            if configs[1] then
                configList:SetValue(configs[1], true)
            end
            configList:SetValue(nil, true)
            configList:SetValue(configs[1], true)
        end
    end

    Groupbox:AddButton({ Text = "Create config", Func = function()
        local n = Library.Options.ConfigNameInput and Library.Options.ConfigNameInput.Value or ""
        if #n == 0 then n = "config" end
        SaveManager:Save(n)
        refreshList()
    end })

    configList = Groupbox:AddDropdown("ConfigDropdown", {
        Text = "Configs",
        Values = SaveManager:GetConfigs(),
        Default = 1,
    })

    Groupbox:AddButton({ Text = "Load", Func = function()
        local v = Library.Options.ConfigDropdown.Value
        if v then SaveManager:Load(v) end
    end })

    Groupbox:AddButton({ Text = "Save", Func = function()
        local v = Library.Options.ConfigDropdown.Value
        if v then SaveManager:Save(v) end
    end })

    Groupbox:AddButton({ Text = "Delete", Func = function()
        local v = Library.Options.ConfigDropdown.Value
        if v then
            SaveManager:Delete(v)
            Library:Notify({ Title = "SaveManager", Description = 'Config "' .. v .. '" deleted.', Time = 3 })
            refreshList()
        end
    end })

    Groupbox:AddButton({ Text = "Refresh", Func = refreshList })

    Groupbox:AddToggle("ConfigAutoload", {
        Text = "Autoload selected config",
        Callback = function(v)
            if not hasfile then return end
            local name = v and Library.Options.ConfigDropdown.Value or ""
            pcall(makefolder, self.Folder)
            pcall(makefolder, self.Folder .. "/settings")
            if self.SubFolder then pcall(makefolder, self.Folder .. "/settings/" .. self.SubFolder) end
            pcall(writefile, self:BuildPath() .. "/autoload.txt", name or "")
        end,
    })

    return Groupbox
end

Library.ThemeManager = ThemeManager
Library.SaveManager = SaveManager

return Library, ThemeManager, SaveManager
