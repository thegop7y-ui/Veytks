local function Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Library.Signals, c)
    return c
end
Library.Connect = Connect

local function New(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            pcall(function() inst[k] = v end)
        end
    end
    inst.Parent = parent
    return inst
end

local function Corner(p, r)
    return New("UICorner", { CornerRadius = UDim.new(0, r or Library.CornerRadius) }, p)
end

local function Stroke(p, color, transparency)
    return New("UIStroke", {
        Color = color or Library.Scheme.Stroke,
        Transparency = transparency or 0,
        Thickness = 1,
    }, p)
end

-- text with black outline
local function Outline(lbl)
    New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 1,
        Transparency = 0.35,
    }, lbl)
end

local FONT      = Enum.Font.GothamMedium
local FONT_BOLD = Enum.Font.GothamBold

local function AddText(parent, text, size, color, bold, align, wrap)
    local l = New("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, size + 8),
        Font = bold and FONT_BOLD or FONT,
        TextSize = size,
        TextColor3 = color or Library.Scheme.Text,
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = wrap or false,
        Text = text or "",
        RichText = true,
    }, parent)
    Outline(l)
    return l
end
Library.AddText = AddText

local function Tween(obj, t, props)
    TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
end

local function RegisterThemeObject(obj, prop, key)
    table.insert(Library._themeObjects, { Obj = obj, Prop = prop, Key = key })
end
Library.RegisterThemeObject = RegisterThemeObject

-- element base: OnChanged / SetValue plumbing
local function MakeElement(idx, defaultValue)
    local element = { Value = defaultValue, _onChanged = {}, Idx = idx }
    function element:OnChanged(fn)
        table.insert(self._onChanged, fn)
        return self
    end
    function element:_Fire()
        for _, fn in ipairs(self._onChanged) do
            task.spawn(fn, self.Value)
        end
    end
    return element
end

--------------------------------------------------------------------
-- key helpers (shared)
--------------------------------------------------------------------
local function KeyToString(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return input.KeyCode.Name
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then return "MB1"
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then return "MB2"
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then return "MB3" end
    return nil
end

local function StringToInput(str)
    str = tostring(str)
    if str == "MB1" then return nil, Enum.UserInputType.MouseButton1 end
    if str == "MB2" then return nil, Enum.UserInputType.MouseButton2 end
    if str == "MB3" then return nil, Enum.UserInputType.MouseButton3 end
    local ok, kc = pcall(function() return Enum.KeyCode[str] end)
    if ok then return kc end
    return nil
end

local function MatchesInput(str, input)
    if not str then return false end
    if str == "MB1" then return input.UserInputType == Enum.UserInputType.MouseButton1 end
    if str == "MB2" then return input.UserInputType == Enum.UserInputType.MouseButton2 end
    if str == "MB3" then return input.UserInputType == Enum.UserInputType.MouseButton3 end
    return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == str
end

