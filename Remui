    ----------------------------------------------------------------
    -- KeyPicker builder
    ----------------------------------------------------------------
    local function BuildKeyPicker(parent, idx, info)
        info = info or {}
        local picker = MakeElement(idx, info.Default or "None")
        picker.Mode = info.Mode or "Toggle"
        picker.Text = info.Text
        picker.NoUI = info.NoUI
        picker.SyncToggleState = info.SyncToggleState
        picker.WaitForCallback = info.WaitForCallback
        picker.Callback = info.Callback
        picker.ChangedCallback = info.ChangedCallback
        picker._held = false
        picker._state = false

        local btn = New("TextButton", {
            Size = UDim2.new(0, 52, 0, 16),
            BackgroundColor3 = Library.Scheme.Container,
            TextColor3 = Library.Scheme.Dim,
            Font = FONT,
            TextSize = 10,
            Text = "[" .. tostring(picker.Value) .. "]",
            AutoButtonColor = false,
            LayoutOrder = 10,
        }, parent)
        Corner(btn, 2)
        Stroke(btn)

        picker.Display = btn

        local listening = false
        btn.MouseButton1Click:Connect(function()
            if info.Disabled then return end
            listening = true
            btn.Text = "[...]"
        end)

        local function Apply(newKey)
            picker.Value = newKey
            btn.Text = "[" .. tostring(newKey) .. "]"
            if picker.ChangedCallback then
                task.spawn(picker.ChangedCallback, StringToInput(newKey), picker.Modifiers)
            end
            picker:_Fire()
            Library:UpdateKeybindMenu()
        end

        function picker:SetValue(v)
            if type(v) == "table" then
                if v[1] then Apply(tostring(v[1])) end
                if v[2] then
                    picker.Mode = tostring(v[2])
                    Library:UpdateKeybindMenu()
                end
            else
                Apply(tostring(v))
            end
        end

        Connect(UserInputService.InputBegan, function(input, gpe)
            if Library.Unloaded then return end
            if listening then
                local name = KeyToString(input)
                if name then
                    Apply(name)
                    listening = false
                end
                return
            end
            if not MatchesInput(picker.Value, input) then return end
            if picker.Mode == "Always" then return end
            if gpe and picker.Mode ~= "Press" then return end

            if picker.Mode == "Toggle" then
                picker._state = not picker._state
                if picker.Callback then task.spawn(picker.Callback, picker._state) end
                if picker._onClick then task.spawn(picker._onClick, picker._state) end
                picker:_Fire()
            elseif picker.Mode == "Hold" then
                picker._held = true
                if picker.Callback then task.spawn(picker.Callback, true) end
                if picker._onClick then task.spawn(picker._onClick, true) end
                picker:_Fire()
            elseif picker.Mode == "Press" then
                if picker.WaitForCallback and picker.Callback then
                    picker.Callback(true)
                else
                    if picker.Callback then task.spawn(picker.Callback, true) end
                end
                if picker._onClick then task.spawn(picker._onClick, true) end
                picker:_Fire()
            end

            if picker.SyncToggleState and picker._toggle then
                picker._toggle:SetValue(picker.Mode == "Toggle" and picker._state or true)
            end
        end)

        Connect(UserInputService.InputEnded, function(input)
            if picker.Mode == "Hold" and picker._held and MatchesInput(picker.Value, input) then
                picker._held = false
                if picker.Callback then task.spawn(picker.Callback, false) end
                picker:_Fire()
            end
        end)

        function picker:GetState()
            if picker.Mode == "Always" then return true end
            if picker.Mode == "Hold" then return picker._held end
            return picker._state
        end

        function picker:OnClick(fn)
            self._onClick = fn
            return self
        end

        table.insert(Library._keybinds, picker)
        Library:UpdateKeybindMenu()
        HookTooltip(btn, info)
        return picker
    end
    Library._buildKeyPicker = BuildKeyPicker

    ----------------------------------------------------------------
    -- ColorPicker builder
    ----------------------------------------------------------------
    local function BuildColorPicker(parent, idx, info)
        info = info or {}
        local picker = MakeElement(idx, info.Default or Color3.new(1, 1, 1))
        picker.Transparency = info.Transparency or 0
        picker.Callback = info.Callback
        picker.Title = info.Title

        local swatch = New("TextButton", {
            Size = UDim2.new(0, 16, 0, 16),
            BackgroundColor3 = picker.Value,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = 11,
        }, parent)
        Corner(swatch, 2)
        Stroke(swatch)

        local function Fire()
            if picker.Callback then task.spawn(picker.Callback, picker.Value) end
            picker:_Fire()
        end

        function picker:SetValueRGB(c3)
            picker.Value = c3
            swatch.BackgroundColor3 = c3
            Fire()
        end
        function picker:SetValue(v)
            if typeof(v) == "Color3" then picker:SetValueRGB(v) end
        end

        swatch.MouseButton1Click:Connect(function()
            if info.Disabled then return end
            Library:ClosePopups()
            ClickCatcher(60)

            local popup = New("Frame", {
                Size = UDim2.new(0, 210, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Position = UDim2.new(0, swatch.AbsolutePosition.X, 0, swatch.AbsolutePosition.Y + 20),
                BackgroundColor3 = Library.Scheme.Background,
                BorderSizePixel = 0,
                ZIndex = 61,
            }, popupLayer)
            Corner(popup)
            Stroke(popup)
            New("UIPadding", {
                PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
                PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
            }, popup)
            TrackPopup(popup)

            AddText(popup, info.Title or "Color", 11, Library.Scheme.Text, true)

            local preview = New("Frame", {
                Size = UDim2.new(1, 0, 0, 18),
                BackgroundColor3 = picker.Value,
                BorderSizePixel = 0,
            }, popup)
            Corner(preview, 3)
            Stroke(preview)

            local function MiniSlider(name, get, set)
                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundTransparency = 1,
                }, popup)
                AddText(row, name, 10, Library.Scheme.Dim).Size = UDim2.new(0, 14, 0, 12)
                local valLbl = AddText(row, tostring(math.floor(get() * 255 + 0.5)), 10,
                    Library.Scheme.Text, false, Enum.TextXAlignment.Right)
                valLbl.Position = UDim2.new(1, -30, 0, 0)
                valLbl.Size = UDim2.new(0, 30, 0, 12)

                local bar = New("Frame", {
                    Size = UDim2.new(1, -48, 0, 5),
                    Position = UDim2.new(0, 16, 0, 15),
                    BackgroundColor3 = Library.Scheme.Container,
                    BorderSizePixel = 0,
                }, row)
                Corner(bar, 2)
                Stroke(bar)
                local fill = New("Frame", {
                    Size = UDim2.new(get(), 0, 1, 0),
                    BackgroundColor3 = Library.Scheme.Accent,
                    BorderSizePixel = 0,
                }, bar)
                Corner(fill, 2)
                RegisterThemeObject(fill, "BackgroundColor3", "Accent")

                local dragging = false
                local function setFromX(x)
                    local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    set(rel)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    valLbl.Text = tostring(math.floor(get() * 255 + 0.5))
                    preview.BackgroundColor3 = picker.Value
                    swatch.BackgroundColor3 = picker.Value
                    Fire()
                end
                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        setFromX(input.Position.X)
                    end
                end)
                Connect(UserInputService.InputChanged, function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        setFromX(input.Position.X)
                    end
                end)
                Connect(UserInputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
            end

            MiniSlider("R", function() return picker.Value.R end,
                function(v) picker.Value = Color3.new(v, picker.Value.G, picker.Value.B) end)
            MiniSlider("G", function() return picker.Value.G end,
                function(v) picker.Value = Color3.new(picker.Value.R, v, picker.Value.B) end)
            MiniSlider("B", function() return picker.Value.B end,
                function(v) picker.Value = Color3.new(picker.Value.R, picker.Value.G, v) end)
            if info.Transparency ~= nil then
                MiniSlider("T", function() return 1 - picker.Transparency end,
                    function(v) picker.Transparency = 1 - v end)
            end
        end)

        HookTooltip(swatch, info)
        return picker
    end
    Library._buildColorPicker = BuildColorPicker

    ----------------------------------------------------------------
    -- element container (groupbox / tabbox-tab / tab direct)
    ----------------------------------------------------------------
    local function AttachElements(Container, elementHolder)

        local function Resolve(idx, info)
            if type(idx) == "table" then info = idx idx = info.Text or info.Name end
            return idx, info or {}
        end

        ---------------------------------------------------------------- Toggle / Checkbox
        function Container:AddToggle(idx, info)
            idx, info = Resolve(idx, info)
            local toggle = MakeElement(idx, info.Default == true)
            toggle.Text = info.Text or idx
            toggle.Callback = info.Callback
            toggle.Type = "Toggle"

            local holder = New("Frame", {
                Size = UDim2.new(1, 0, 0, 20),
                BackgroundTransparency = 1,
                Visible = info.Visible ~= false,
            }, elementHolder)

            local box = New("TextButton", {
                Size = UDim2.new(0, 16, 0, 16),
                Position = UDim2.new(0, 0, 0, 1),
                BackgroundColor3 = toggle.Value and Library.Scheme.Accent or Library.Scheme.Element,
                Text = "",
                AutoButtonColor = false,
            }, holder)
            Corner(box, 3)
            Stroke(box)

            local inner = New("Frame", {
                Size = UDim2.new(0, 8, 0, 8),
                Position = UDim2.new(0.5, -4, 0.5, -4),
                BackgroundColor3 = Color3.new(1, 1, 1),
                Visible = toggle.Value,
                BorderSizePixel = 0,
            }, box)
            Corner(inner, 1)
            toggle._inner = inner

            local lbl = AddText(holder, toggle.Text, 12,
                info.Risky and Library.Scheme.Red or Library.Scheme.Text)
            lbl.Position = UDim2.new(0, 24, 0, 0)
            lbl.Size = UDim2.new(1, -80, 0, 18)

            local extras = New("Frame", {
                Size = UDim2.new(0, 120, 1, 0),
                Position = UDim2.new(1, -120, 0, 0),
                BackgroundTransparency = 1,
            }, holder)
            New("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                HorizontalAlignment = Enum.HorizontalAlignment.Right,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                Padding = UDim.new(0, 4),
            }, extras)

            if info.Disabled then
                lbl.TextTransparency = 0.5
                inner.BackgroundTransparency = 0.5
            end

            local function setVisual()
                inner.Visible = toggle.Value
                box.BackgroundColor3 = toggle.Value and Library.Scheme.Accent or Library.Scheme.Element
            end

            function toggle:SetValue(v)
                toggle.Value = not not v
                setVisual()
                if toggle.Callback then task.spawn(toggle.Callback, toggle.Value) end
                toggle:_Fire()
                if toggle._keyPicker and toggle._keyPicker.SyncToggleState then
                    toggle._keyPicker._state = toggle.Value
                end
            end

            box.MouseButton1Click:Connect(function()
                if info.Disabled then return end
                toggle:SetValue(not toggle.Value)
            end)

            function toggle:AddColorPicker(cIdx, cInfo)
                local cp = BuildColorPicker(extras, cIdx, cInfo)
                Options[cIdx] = cp
                toggle._colorPicker = cp
                return cp
            end
            function toggle:AddKeyPicker(kIdx, kInfo)
                local kp = BuildKeyPicker(extras, kIdx, kInfo)
                kp._toggle = toggle
                Options[kIdx] = kp
                toggle._keyPicker = kp
                return kp
            end

            Toggles[idx] = toggle
            HookTooltip(box, info)
            HookTooltip(lbl, info)
            return toggle
        end

        function Container:AddCheckbox(idx, info)
            return Container:AddToggle(idx, info)
        end

        ---------------------------------------------------------------- Button
        function Container:AddButton(idx, info)
            if type(idx) == "string" and type(info) == "function" then
                info = { Text = idx, Func = info }
                idx = info.Text
            end
            idx, info = Resolve(idx, info)

            local holder = New("Frame", {
                Size = UDim2.new(1, 0, 0, 20),
                BackgroundTransparency = 1,
                Visible = info.Visible ~= false,
            }, elementHolder)
            New("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                Padding = UDim.new(0, 4),
            }, holder)

            local btnObj = {}

            local function MakeButton(opts, width)
                local btn = New("TextButton", {
                    Size = width,
                    BackgroundColor3 = Library.Scheme.Container,
                    TextColor3 = (opts.Risky and Library.Scheme.Red) or Library.Scheme.Text,
                    Font = FONT,
                    TextSize = 12,
                    Text = opts.Text or "Button",
                    AutoButtonColor = false,
                }, holder)
                Corner(btn)
                Stroke(btn)

                local clicks = 0
                btn.MouseEnter:Connect(function()
                    Tween(btn, .1, { BackgroundColor3 = Library.Scheme.Element })
                end)
                btn.MouseLeave:Connect(function()
                    Tween(btn, .1, { BackgroundColor3 = Library.Scheme.Container })
                end)
                btn.MouseButton1Click:Connect(function()
                    if opts.Disabled then return end
                    clicks += 1
                    if opts.DoubleClick then
                        if clicks >= 2 then
                            clicks = 0
                            if opts.Func then task.spawn(opts.Func) end
                        else
                            btn.Text = "Click again"
                            task.delay(0.4, function() btn.Text = opts.Text or "Button" end)
                        end
                    else
                        if opts.Func then task.spawn(opts.Func) end
                    end
                end)
                HookTooltip(btn, opts)
                return btn
            end

            MakeButton(info, UDim2.new(1, 0, 0, 20))

            function btnObj:AddButton(subIdx, subInfo)
                if type(subIdx) == "string" and type(subInfo) == "function" then
                    subInfo = { Text = subIdx, Func = subInfo }
                elseif type(subIdx) == "table" then
                    subInfo = subIdx
                end
                local first = holder:FindFirstChildWhichIsA("TextButton")
                if first then first.Size = UDim2.new(0.5, -2, 0, 20) end
                MakeButton(subInfo or {}, UDim2.new(0.5, -2, 0, 20))
                return btnObj
            end

            return btnObj
        end

