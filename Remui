        local n = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Library.Scheme.Background,
            BorderSizePixel = 0,
            LayoutOrder = tick(),
        }, notifHolder)
