-- SaveManager (meme fichier)
--------------------------------------------------------------------
local SaveManager = {}
SaveManager.Folder = 'ui_lib'
SaveManager.SubFolder = nil
SaveManager.Ignore = {}
SaveManager.Library = Library
SaveManager._current = nil

function SaveManager:SetLibrary(Lib) self.Library = Lib end
function SaveManager:SetFolder(Folder) self.Folder = Folder end
function SaveManager:SetSubFolder(SubFolder) self.SubFolder = SubFolder end
function SaveManager:SetIgnoreIndexes(Indexes)
    for _, Idx in next, Indexes do self.Ignore[Idx] = true end
end
function SaveManager:IgnoreThemeSettings()
    for Idx in next, ThemeManager.IgnoredIndexes do self.Ignore[Idx] = true end
end

function SaveManager:BuildPath()
    local Path = self.Folder .. '/settings'
    if self.SubFolder then Path = Path .. '/' .. self.SubFolder end
    return Path
end

function SaveManager:GetConfigs()
    local Out = {}
    local Success, Files = pcall(listfiles, self:BuildPath())
    if Success and Files then
        for _, File in next, Files do
            local Name = File:match('([^/\\]+)%.json$')
            if Name and Name ~= 'autoload' then table.insert(Out, Name) end
        end
    end
    table.sort(Out, function(a, b) return a < b end)
    return Out
end

function SaveManager:GetAutoloadConfig()
    local Success, Name = pcall(readfile, self:BuildPath() .. '/autoload.txt')
    if Success and Name and #Name > 0 then return Name end
    return nil
end

function SaveManager:Save(Name)
    Name = tostring(Name or 'config')
    self._current = Name

    local Data = { Objects = {} }

    for Idx, Option in next, Options do
        if not self.Ignore[Idx] then
            if Option.Type == 'Toggle' then
                Data.Objects[Idx] = { Type = 'Toggle', Value = Option.Value }
            elseif Option.Type == 'Slider' then
                Data.Objects[Idx] = { Type = 'Slider', Value = Option.Value }
            elseif Option.Type == 'Input' then
                Data.Objects[Idx] = { Type = 'Input', Value = Option.Value }
            elseif Option.Type == 'Dropdown' then
                Data.Objects[Idx] = { Type = 'Dropdown', Value = Option.Value }
            elseif Option.Type == 'ColorPicker' then
                Data.Objects[Idx] = {
                    Type = 'ColorPicker';
                    R = Option.Value.R; G = Option.Value.G; B = Option.Value.B;
                    Transparency = Option.Transparency;
                }
            elseif Option.Type == 'KeyPicker' then
                Data.Objects[Idx] = { Type = 'KeyPicker', Key = Option.Value, Mode = Option.Mode }
            end
        end
    end

    pcall(makefolder, self.Folder)
    pcall(makefolder, self.Folder .. '/settings')
    if self.SubFolder then pcall(makefolder, self.Folder .. '/settings/' .. self.SubFolder) end

    local Success, Err = pcall(writefile, self:BuildPath() .. '/' .. Name .. '.json', HttpService:JSONEncode(Data))
    if Success then
        Library:Notify('Config "' .. Name .. '" saved.', 3)
    else
        Library:Notify('Failed to save config "' .. Name .. '": ' .. tostring(Err), 5)
    end
    return Success
end

function SaveManager:Load(Name)
    Name = tostring(Name or 'config')
    self._current = Name

    local Success, Content = pcall(readfile, self:BuildPath() .. '/' .. Name .. '.json')
    if (not Success) or (not Content) then
        Library:Notify('Config "' .. Name .. '" not found.', 3)
        return false
    end

    local Data = HttpService:JSONDecode(Content)

    for Idx, Obj in next, Data.Objects or {} do
        local Option = Options[Idx]
        if Option then
            if Obj.Type == 'Toggle' and Option.Type == 'Toggle' then
                Option:SetValue(Obj.Value and true or false)
            elseif Obj.Type == 'Slider' and Option.Type == 'Slider' then
                Option:SetValue(tonumber(Obj.Value) or Option.Value)
            elseif Obj.Type == 'Input' and Option.Type == 'Input' then
                Option:SetValue(tostring(Obj.Value or ''))
            elseif Obj.Type == 'Dropdown' and Option.Type == 'Dropdown' then
                Option:SetValue(Obj.Value)
            elseif Obj.Type == 'ColorPicker' and Option.Type == 'ColorPicker' then
                Option:SetValueRGB(Color3.new(Obj.R or 1, Obj.G or 1, Obj.B or 1), Obj.Transparency or 0)
            elseif Obj.Type == 'KeyPicker' and Option.Type == 'KeyPicker' then
                Option:SetValue({ Obj.Key or 'None', Obj.Mode or 'Toggle' })
            end
        end
    end

    Library:Notify('Config "' .. Name .. '" loaded.', 3)
    return true
end

function SaveManager:Delete(Name)
    pcall(delfile, self:BuildPath() .. '/' .. tostring(Name) .. '.json')
end

function SaveManager:LoadAutoloadConfig()
    local Name = self:GetAutoloadConfig()
    if Name then self:Load(Name) end
end

function SaveManager:BuildConfigSection(Tab)
    local Groupbox = Tab:AddLeftGroupbox('Configuration')

    Groupbox:AddInput('ConfigNameInput', {
        Text = 'Config name';
        Default = '';
        Placeholder = 'config name';
        Finished = true;
    })

    local ConfigList

    local function RefreshList(SelectFirst)
        if not ConfigList then return end
        local Configs = self:GetConfigs()
        ConfigList:SetValues(Configs)
        if SelectFirst and Configs[1] then
            ConfigList:SetValue(Configs[1])
        end
    end

    Groupbox:AddButton({
        Text = 'Create config';
        Func = function()
            local Name = Options.ConfigNameInput.Value
            if #Name == 0 then Name = 'config' end
            self:Save(Name)
            RefreshList(true)
        end;
        Tooltip = 'Creates a new config with the name above';
    })

    ConfigList = Groupbox:AddDropdown('ConfigList', {
        Text = 'Configs';
        Values = self:GetConfigs();
        AllowNull = true;
    })

    Groupbox:AddButton({ Text = 'Load';  Func = function() local Name = Options.ConfigList.Value; if Name then self:Load(Name) end end; })
    Groupbox:AddButton({ Text = 'Save';  Func = function() local Name = Options.ConfigList.Value; if Name then self:Save(Name) end end; })
    Groupbox:AddButton({
        Text = 'Delete';
        Func = function()
            local Name = Options.ConfigList.Value
            if Name then
                self:Delete(Name)
                Library:Notify('Config "' .. Name .. '" deleted.', 3)
                RefreshList(true)
            end
        end;
    })
    Groupbox:AddButton({ Text = 'Refresh'; Func = function() RefreshList(true) end; })

    Groupbox:AddToggle('ConfigAutoLoad', {
        Text = 'Autoload selected config';
        Default = false;
        Callback = function(Value)
            pcall(makefolder, self.Folder)
            pcall(makefolder, self.Folder .. '/settings')
            if self.SubFolder then pcall(makefolder, self.Folder .. '/settings/' .. self.SubFolder) end
            local Name = Value and Options.ConfigList.Value or ''
            pcall(writefile, self:BuildPath() .. '/autoload.txt', Name or '')
        end;
    })

    return Groupbox
end

Library.ThemeManager = ThemeManager
Library.SaveManager = SaveManager

getgenv().Library = Library
getgenv().ThemeManager = ThemeManager
getgenv().SaveManager = SaveManager

return Library, ThemeManager, SaveManager
